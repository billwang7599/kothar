---
// Shell for Overview and Features: head and social tags, the self-hosted fonts, the sticky nav, the footer and the
// page scripts (site.ts for reveals and smooth jumps, replay.ts for the engine cards, the star count).
// The look is written down in website/DESIGN.md.
import '@fontsource-variable/archivo/wdth.css'
import '@fontsource/ibm-plex-mono/400.css'
import '@fontsource/ibm-plex-mono/600.css'
import '../styles/site.css'
import Nav from '../components/Nav.astro'
import { REPO, RELEASES } from '../lib/release'

interface Props {
  title: string
  description: string
  current: 'overview' | 'features'
}
const { title, description, current } = Astro.props
const url = new URL(Astro.url.pathname, Astro.site)
---

<!doctype html>
<html lang="en" id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={url} />
    <meta name="theme-color" content="#8a9dc4" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kothar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      // Before the first paint: .js lets the engine cards show their first frame instead of their last. With reduced
      // motion, .still keeps every card on its final frame and nothing moves. Otherwise .motion hides what will
      // reveal; if site.ts never runs, it is dropped after a moment so nothing stays hidden.
      {
        const root = document.documentElement
        root.classList.add('js')
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) root.classList.add('still')
        else {
          root.classList.add('motion')
          setTimeout(() => window.kotharSite || root.classList.remove('motion'), 2500)
        }
      }
    </script>
  </head>
  <body>
    <Nav current={current} />
    <main>
      <slot />
    </main>
    <footer class="inked">
      <div class="w foot">
        <span>Source-available under FSL-1.1-ALv2, which becomes Apache 2.0 two years after each release. The extension API is MIT.</span>
        <span class="foot-links">
          <a href="/docs/">Wiki</a>
          <a href={REPO}>GitHub</a>
          <a href={RELEASES}>Releases</a>
          <a href="/docs/faq/">FAQ</a>
          <a class="top-link" href="#top">Back to top <span aria-hidden="true">↑</span></a>
        </span>
      </div>
    </footer>

    <script>
      import '../scripts/site'
      import '../components/replay/replay'
    </script>

    <script>
      // The Star on GitHub buttons' count, fetched in the browser (never at build time) and kept for an hour so
      // repeat visits don't spend GitHub's rate limit. Any failure, or no stars yet, leaves the count hidden.
      const KEY = 'kothar-stars'
      const HOUR = 3_600_000
      const slots = [...document.querySelectorAll<HTMLElement>('[data-stars]')]
      const short = (n: number) => (n >= 1000 ? `${(n / 1000).toFixed(n >= 10_000 ? 0 : 1).replace(/\.0$/, '')}k` : String(n))
      const fill = (n: number) => {
        if (!Number.isFinite(n) || n < 1) return
        for (const slot of slots) {
          slot.textContent = short(n)
          slot.classList.add('shown')
          slot.closest('a')?.setAttribute('aria-label', `Star Kothar on GitHub (${n.toLocaleString('en')} stars)`)
        }
      }
      const load = async () => {
        try {
          const saved = JSON.parse(sessionStorage.getItem(KEY) ?? 'null')
          if (saved && Date.now() - saved.at < HOUR) return fill(saved.n)
        } catch {}
        try {
          const res = await fetch('https://api.github.com/repos/billwang7599/kothar', { headers: { accept: 'application/vnd.github+json' } })
          if (!res.ok) return
          const n = (await res.json()).stargazers_count
          if (typeof n !== 'number') return
          try {
            sessionStorage.setItem(KEY, JSON.stringify({ n, at: Date.now() }))
          } catch {}
          fill(n)
        } catch {}
      }
      if (slots.length) void load()
    </script>
  </body>
</html>

<style>
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px 24px;
    padding: 18px 10px 24px;
    border-top: 1px solid rgb(237 236 230 / 0.18);
    font: 400 11.5px/1.5 var(--mono);
    color: var(--on-ink-muted);
  }
  .foot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }
  .foot a {
    color: var(--paper);
  }
</style>
