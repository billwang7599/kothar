---
// Shell for the marketing pages: head, theme, the frosted nav, footer and the reveal animations.
import '@fontsource-variable/inter'
import '../styles/site.css'
import Nav from '../components/Nav.astro'
import { REPO } from '../lib/release'

interface Props {
  title: string
  description: string
  current: 'overview' | 'features'
}
const { title, description, current } = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline>
      // Shares the docs' theme choice (Starlight keeps it under this key): 'light', 'dark' or '' for the system's.
      const pick = localStorage.getItem('starlight-theme')
      const dark = pick === 'dark' || pick === 'light' ? pick === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches
      document.documentElement.dataset.theme = dark ? 'dark' : 'light'
      // Hide what will animate in only when JS runs and motion is welcome. If the animation script never loads,
      // show everything after a moment.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('motion')
        setTimeout(() => window.motionReady || document.documentElement.classList.remove('motion'), 2500)
      }
    </script>
  </head>
  <body>
    <Nav current={current} />
    <main>
      <slot />
    </main>
    <footer class="wrap">
      <span>Kothar is source-available under FSL-1.1-ALv2. The extension API is MIT.</span>
      <span><a href="/docs/">Wiki</a> · <a href={REPO}>GitHub</a> · <a href="/docs/faq/">FAQ</a></span>
    </footer>

    <script>
      import { animate, inView, scroll, stagger } from 'motion'

      const root = document.documentElement
      if (root.classList.contains('motion')) {
        const ease = [0.16, 1, 0.3, 1] as const
        const all = (sel: string, scope: ParentNode = document) => [...scope.querySelectorAll<HTMLElement>(sel)]
        const show = (els: HTMLElement[], step: number) =>
          animate(els, { opacity: 1, y: 0 }, { duration: 0.8, ease, delay: stagger(step) })

        // Take over the hidden state with inline styles, then drop the class.
        const hero = all('[data-hero]')
        const sections = all('[data-reveal]').map((s) => [s, [...s.children] as HTMLElement[]] as const)
        animate(hero, { opacity: 0, y: 16 }, { duration: 0 })
        sections.forEach(([, parts]) => animate(parts, { opacity: 0, y: 16 }, { duration: 0 }))
        root.classList.remove('motion')
        ;(window as unknown as { motionReady: boolean }).motionReady = true

        // The hero rises in, one line after another.
        show(hero, 0.1)

        // Each section's parts rise in as it comes into view.
        sections.forEach(([section, parts]) => inView(section, () => void show(parts, 0.1), { amount: 0.2 }))

        // The hero screenshot settles to full size as it scrolls into place.
        const shot = document.querySelector('[data-shot]')
        if (shot) {
          scroll(animate(shot, { scale: [0.94, 1] }, { ease: 'linear' }), {
            target: shot,
            offset: ['start end', 'center center'],
          })
        }
      }
    </script>
  </body>
</html>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    padding-block: 28px 40px;
    border-top: 1px solid var(--hair);
    color: var(--muted);
    font-size: 13px;
  }
  footer a {
    color: inherit;
  }
  footer a:hover {
    color: var(--text);
  }
</style>
