---
// Overview: the specimen homepage. A blue field with the hero, five engine cards replaying scripted sessions and the
// KOTHAR wordmark; a sheet of five numbered sections; the builder's story on ink. See DESIGN.md.
import Site from '../layouts/Site.astro'
import Spec, { type SpecItem } from '../components/Spec.astro'
import Session from '../components/replay/Session.astro'
import { sessions } from '../components/replay/sessions'
import { latestRelease, REPO, RELEASES } from '../lib/release'
import { starIcon } from '../lib/icons'
import engines from '../assets/home/engines.png'
import extensions from '../assets/home/extensions.webp'
import approval from '../assets/home/approval.png'
import worker from '../assets/home/worker.png'
import usage from '../assets/home/usage.webp'

const release = latestRelease()
const facts =
  'Claude Code, Codex, pi, OpenCode and any ACP agent in one Mac app. Switch engines mid-chat and keep your history, extensions and settings.'

const specs: SpecItem[] = [
  {
    id: 'engines',
    tag: 'ENG',
    n: '01',
    label: 'Engines',
    title: 'Claude Code, Codex, OpenCode and pi, each signed in with your own account.',
    body: 'Kothar drives every engine headless through its own protocol, so your subscription or API key pays for the work. Any agent that speaks the Agent Client Protocol can be added. The chat’s history lives in Kothar, not in the engine, so the next message can go to a different one.',
    link: { href: '/docs/engines/', label: 'How engines work' },
    img: engines,
    alt: 'Settings, Engines: claude-code, pi and opencode switched on, each marked Ready with its version, and an Add ACP agent button',
    where: 'Settings → Engines',
  },
  {
    id: 'extensions',
    tag: 'EXT',
    n: '02',
    label: 'Extensions',
    title: 'Write an extension once and it works with every engine.',
    body: 'Extensions add tools, panels and settings through one API, which is MIT-licensed. Artifacts, Browser, Deep Research, Git, Notes, Plan, MCP servers and more ship built in, each with its own switch. Themes and community extensions install from the Marketplace.',
    link: { href: '/docs/extensions/', label: 'Extensions' },
    img: extensions,
    alt: 'Settings, Built-in extensions: Account rotation, Artifacts, Browser, Deep Research and Git, each with a description and an on/off switch',
    where: 'Settings → Built-in extensions',
  },
  {
    id: 'approvals',
    tag: 'APR',
    n: '03',
    label: 'Approvals',
    title: 'Agents work inside a sandboxed folder. Anything outside it waits for you.',
    body: 'A push, a write somewhere else, a network call: each shows up as a card in the chat with the exact command, and nothing happens until you approve or deny it. The sandbox is macOS’s own.',
    link: { href: '/docs/permissions/', label: 'Permissions' },
    img: approval,
    alt: 'A Bash tool row for git push -u origin fix/double-charge, waiting for approval, above a card asking Allow Bash? with Approve and Deny buttons',
    where: 'Chat · approval card',
  },
  {
    id: 'workers',
    tag: 'WRK',
    n: '04',
    label: 'Workers',
    title: 'Hand a task to a worker and keep talking to the lead.',
    body: 'Each worker runs on its own branch while you carry on. When it reports back, its changes wait in the chat: Merge keeps its commits, Squash lands them as one, or you keep or discard the branch.',
    link: { href: '/docs/workers/', label: 'Workers' },
    img: worker,
    alt: 'A worker report: 2 files changed, +32 −0, 1 commit, with Merge, Squash, Keep and Discard buttons and the worker’s summary',
    where: 'Chat · worker report',
  },
  {
    id: 'usage',
    tag: 'USE',
    n: '05',
    label: 'Usage',
    title: 'See what each chat and its workers cost, as the engines report it.',
    body: 'Tokens in and out, cache reads and writes, and cost per chat, with workers on their own line. A subscription is billed its own way, and the popover says so.',
    link: { href: '/docs/usage/', label: 'Usage' },
    img: usage,
    alt: 'The chat header’s $0.32 total with its usage popover open: this chat $0.22, workers $0.097, input 53k tokens, output 4.2k tokens, cost $0.32 over 4 turns',
    where: 'Chat header · usage',
    narrow: true,
  },
]
---

<Site title="Kothar: Switch agents. Keep everything." description={facts} current="overview">
  <!-- ───────────── Hero ───────────── -->
  <header class="hero field lines">
    <div class="w intro" data-reveal>
      <h1 style="--i: 0">Switch agents.<br />Keep everything.</h1>
      <p class="claim" style="--i: 1">The last agent orchestrator you’ll ever need.</p>
      <p class="facts" style="--i: 2">{facts}</p>
      <div class="cta" style="--i: 3">
        <a class="btn solid" href={release.href} data-download>Download for Mac</a>
        <a class="btn line" href={REPO}><Fragment set:html={starIcon.replace('<svg', '<svg class="star"')} />Star on GitHub<span class="count" data-stars></span></a>
      </div>
      <p class="fine" style="--i: 4"><span>macOS 13+ · Apple silicon</span> · <span>signed and notarized</span> · <a href={RELEASES}>all releases</a></p>
    </div>

    <div class="w bench">
      <div class="replay-bar">
        <span><i aria-hidden="true"></i>Replays of demo sessions, scripted by hand, not recordings.</span>
        <button type="button" class="replay" data-replay-toggle aria-pressed="false" hidden>Pause</button>
      </div>
      <ol class="cards" data-reveal>
        {
          sessions.map((s, i) => (
            <li class="card" style={`--i: ${i}`}>
              <div class="card-h">
                <b>[{s.tag}]</b>
                <b>{s.n}</b>
              </div>
              <div class="card-e">{s.engine}</div>
              <Session lines={s.lines} offset={s.offset} />
            </li>
          ))
        }
      </ol>
    </div>

    <svg class="word hero-word" viewBox="0 0 1000 190" role="img" aria-label="Kothar">
      <text x="0" y="200" textLength="1000" lengthAdjust="spacingAndGlyphs">KOTHAR</text>
      <rect x="0" y="96" width="1000" height="5" class="cut"></rect>
    </svg>
  </header>

  <!-- ───────────── Specimen sheet ───────────── -->
  <div class="sheet lines">
    <nav class="w toc" aria-label="On this page">
      <span class="k">Contents</span>
      {
        specs.map((s) => (
          <a class="ul" href={`#${s.id}`}>
            <b>[{s.n}]</b> {s.label}
          </a>
        ))
      }
      <a class="ul" href="#maker"><b>[06]</b> Who makes this</a>
    </nav>

    {specs.map((s) => <Spec spec={s} />)}

    <div class="w all">
      <a class="more" href="/features/">Every feature, one at a time <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <!-- ───────────── Closing: who makes this ───────────── -->
  <section class="close inked lines" id="maker" aria-labelledby="maker-h">
    <div class="w story" data-reveal>
      <div class="num" style="--i: 0">
        <span class="k">[MKR]</span>
        <span class="big" aria-hidden="true">06</span>
      </div>
      <div class="copy" style="--i: 1">
        <span class="k">Who makes this</span>
        <h2 id="maker-h">Kothar is built by one person.</h2>
        <p>
          I’m Bill. I had Claude Code, Codex and pi open in separate terminals and kept losing track of which one was
          doing what. In November 2026 I started building one app
          to drive them all.
        </p>
        <p>
          It’s early and it has rough edges. If something breaks or is missing, <a href={`${REPO}/issues`}>open an issue
          on GitHub</a>. The code is source-available, so you can read exactly what it does.
        </p>
        <p>
          The name comes from Kothar-wa-Khasis, the craftsman of Ugaritic myth who built the gods’ tools.
        </p>
      </div>
      <div class="ask-star" style="--i: 2">
        <p class="ask">If you want to see where it goes, a star on GitHub helps more than you’d think.</p>
        <div class="cta">
          <a class="btn paper" href={REPO}><Fragment set:html={starIcon.replace('<svg', '<svg class="star"')} />Star on GitHub<span class="count" data-stars></span></a>
          <a class="btn ghost-light" href={release.href} data-download>Download for Mac</a>
        </div>
        <p class="fine">Free. macOS 13+, Apple silicon.</p>
      </div>
    </div>

    <svg class="word ghost" viewBox="0 0 1000 190" aria-hidden="true">
      <text x="0" y="200" textLength="1000" lengthAdjust="spacingAndGlyphs">KOTHAR</text>
    </svg>
  </section>
</Site>

<style>
  /* ── Hero ── */
  .hero {
    overflow: hidden;
  }
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: clamp(20px, 4vh, 52px) 0 0;
  }
  h1 {
    font: 900 clamp(32px, 4.4vw, 64px)/0.98 var(--display);
    font-stretch: 112%;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }
  /* Three ranked lines: the headline, the claim (bold, mid-size), then the facts (regular, small, softer). */
  .claim {
    margin-top: 16px;
    font: 700 clamp(17px, 1.5vw, 21px)/1.3 var(--display);
    font-stretch: 104%;
  }
  .facts {
    max-width: 36em;
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .cta {
    justify-content: center;
    margin-top: 22px;
  }
  .intro .fine {
    margin-top: 12px;
  }
  .intro .fine :is(span, a) {
    white-space: nowrap;
  }

  .bench {
    z-index: 2;
    margin-top: clamp(22px, 4vh, 48px);
  }
  .replay-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin-bottom: 10px;
    font: 400 11.5px/1.3 var(--mono);
  }
  .replay-bar i {
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 8px;
    border-radius: 50%;
    background: var(--ink);
    vertical-align: 1px;
  }
  .replay {
    flex: none;
    padding: 5px 10px;
    border: 1px solid var(--ink);
    background: none;
    color: var(--ink);
    font: 600 11px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--base) var(--ease),
      color var(--base) var(--ease),
      transform var(--fast) var(--ease);
  }
  .replay:hover {
    background: var(--ink);
    color: var(--field);
  }
  .replay:active {
    transform: scale(0.96);
  }
  .cards {
    list-style: none;
    margin: 0 0 calc(-1 * clamp(20px, 3.6vw, 56px));
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(10px, 2.4vw, 40px);
  }
  .card {
    min-width: 0;
    padding: 10px 10px 0;
    background: var(--card);
    box-shadow: 0 1px 0 rgb(14 16 22 / 0.2);
  }
  .card-h {
    display: flex;
    justify-content: space-between;
    font: 900 15px/1 var(--display);
    font-stretch: 112%;
  }
  .card-e {
    margin: 4px 0 8px;
    font: 600 10.5px/1.2 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  /* The wordmark sits under the cards; a band of the field cuts through it like a stencil bridge, and the hero's
     bottom edge crops it. */
  .hero-word {
    margin-bottom: calc(-1 * clamp(14px, 3vw, 46px));
  }

  /* ── Sheet ── */
  .sheet {
    padding: 28px 0 0;
  }
  .all {
    padding: 28px 10px 56px;
  }

  /* ── Closing ── */
  .close {
    overflow: hidden;
    padding-top: 72px;
  }
  .story {
    display: grid;
    grid-template-columns: 1fr 2fr 3fr;
    align-items: start;
  }
  .close .copy h2 {
    font-size: clamp(28px, 3vw, 44px);
  }
  .close .copy p {
    color: var(--on-ink-soft);
  }
  .close .k {
    color: var(--field);
  }
  .ask-star {
    max-width: 30em;
    padding: 34px 10px 0 clamp(16px, 4vw, 64px);
  }
  .ask {
    margin-bottom: 20px;
    font: 700 clamp(18px, 1.6vw, 22px)/1.35 var(--display);
  }
  .close .fine {
    margin-top: 14px;
    color: var(--on-ink-muted);
  }
  .ghost {
    margin-top: 64px;
    margin-bottom: calc(-1 * clamp(30px, 8vw, 120px));
  }
  .ghost text {
    fill: none;
    stroke: var(--field);
    stroke-width: 1.2;
  }

  /* ── Narrower windows ── */
  @media (max-width: 1100px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Three cards fit: the approval (CC), Codex and the worker (pi). */
    .card:nth-child(3),
    .card:nth-child(5) {
      display: none;
    }
  }
  @media (max-width: 1000px) {
    .story {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .close .num {
      flex-direction: row;
      align-items: baseline;
      gap: 14px;
    }
    .ask-star {
      padding-left: 10px;
    }
  }
  @media (max-width: 640px) {
    .intro {
      padding-top: 24px;
    }
    /* On a phone the facts line moves under the buttons, so the headline, claim and Download come first. */
    .facts {
      order: 5;
      margin-top: 14px;
      font-size: 14px;
    }
    .intro .fine {
      order: 6;
    }
    .cta {
      margin-top: 18px;
    }
    .cta .btn {
      flex: 1 1 auto;
    }
    .replay-bar {
      align-items: flex-start;
    }
    /* Two cards on a phone, the approval (CC) and the worker (pi), so the wordmark still shows. */
    .cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: -8px;
    }
    .card:nth-child(2) {
      display: none;
    }
    .card {
      padding: 8px 8px 0;
    }
    .hero-word {
      margin-bottom: -8px;
    }
    .close {
      padding-top: 48px;
    }
  }
</style>
