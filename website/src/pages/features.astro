---
// Features: every feature as a numbered section, with a full-window screenshot each. Same look as the homepage;
// see DESIGN.md.
import Site from '../layouts/Site.astro'
import Spec, { type SpecItem } from '../components/Spec.astro'
import { latestRelease, REPO } from '../lib/release'
import { starIcon } from '../lib/icons'
import engines from '../assets/screenshots/engines.webp'
import extensions from '../assets/home/extensions.webp'
import context from '../assets/screenshots/context.webp'
import workers from '../assets/screenshots/workers.webp'
import approval from '../assets/screenshots/approval.webp'
import usage from '../assets/home/usage.webp'

const release = latestRelease()

// Facts come from the docs; each links to its page there.
const features: SpecItem[] = [
  {
    id: 'engines',
    tag: 'ENG',
    n: '01',
    label: 'Engines',
    title: 'Your agents, your logins.',
    body: 'Kothar drives Claude Code, Codex, OpenCode, pi and any agent that speaks ACP. Each runs with the account you already have. A chat’s history belongs to the chat, so you can switch engines mid-chat and keep it.',
    img: engines,
    alt: 'Settings, Engines: Claude Code, pi and OpenCode, each marked Ready with its version and a switch to turn it on',
    link: { href: '/docs/engines/', label: 'Engines' },
    where: 'Settings → Engines',
  },
  {
    id: 'extensions',
    tag: 'EXT',
    n: '02',
    label: 'Extensions',
    title: 'Write once. Works with every engine.',
    body: 'Panels, commands, tools and permission rules that work with every engine. Built-in extensions each have a switch; install more, and themes, from the Marketplace in Settings.',
    img: extensions,
    alt: 'Settings, Built-in extensions: Account rotation, Artifacts, Browser, Deep Research and Git, each with a description and an on/off switch',
    link: { href: '/docs/extensions/', label: 'Extensions' },
    where: 'Settings → Built-in extensions',
  },
  {
    id: 'spaces',
    tag: 'SPC',
    n: '03',
    label: 'Spaces and memory',
    title: 'A space for each job.',
    body: 'A folder becomes a space, with replies and tool calls streaming live. Every chat remembers its whole conversation, even across restarts.',
    img: context,
    alt: 'A space with a reply streaming in after Read and Grep tool calls, beside the Context panel with its AGENTS.md and folders',
    link: { href: '/docs/spaces/', label: 'Spaces' },
    where: 'A space · Context panel',
  },
  {
    id: 'workers',
    tag: 'WRK',
    n: '04',
    label: 'Workers',
    title: 'Hand off. Then review.',
    body: 'An agent hands tasks to workers, each in its own git worktree. When one reports, you merge, squash, keep or discard its changes.',
    img: workers,
    alt: "A worker's report in the chat: 2 files changed, 1 commit, with Merge, Squash, Keep and Discard buttons",
    link: { href: '/docs/workers/', label: 'Workers' },
    where: 'Chat · worker report',
  },
  {
    id: 'permissions',
    tag: 'APR',
    n: '05',
    label: 'Permissions',
    title: 'Nothing runs behind your back.',
    body: 'On macOS, agents work in a sandboxed folder. Switches decide what runs without asking, and you approve the rest from the chat.',
    img: approval,
    alt: 'An approval card in the chat asking to allow a git push, with Approve and Deny buttons',
    link: { href: '/docs/permissions/', label: 'Permissions' },
    where: 'Chat · approval card',
  },
  {
    id: 'usage',
    tag: 'USE',
    n: '06',
    label: 'Usage',
    title: 'See what each turn used.',
    body: 'Tokens and cost, as each engine reports them, saved per chat. A quiet total sits in the chat header; click it for the breakdown.',
    img: usage,
    alt: "The chat header's usage total of $0.32, with its breakdown open: this chat, workers, tokens and cost",
    link: { href: '/docs/usage/', label: 'Usage' },
    where: 'Chat header · usage',
    narrow: true,
  },
]
---

<Site
  title="Features · Kothar"
  description="Engines, extensions, spaces and memory, workers, permissions and usage in Kothar."
  current="features"
>
  <header class="page-head field lines">
    <div class="w head" data-reveal>
      <span class="k" style="--i: 0">Kothar · Features</span>
      <h1 style="--i: 1">Features</h1>
      <p class="lede" style="--i: 2">What Kothar does, one thing at a time. Each section links to its page in the wiki.</p>
    </div>
    <svg class="word" viewBox="0 0 1000 120" aria-hidden="true">
      <text x="0" y="128" textLength="1000" lengthAdjust="spacingAndGlyphs">FEATURES</text>
    </svg>
  </header>

  <div class="sheet lines">
    <nav class="w toc" aria-label="On this page">
      <span class="k">Contents</span>
      {
        features.map((f) => (
          <a class="ul" href={`#${f.id}`}>
            <b>[{f.n}]</b> {f.label}
          </a>
        ))
      }
    </nav>
    {features.map((f) => <Spec spec={f} />)}
  </div>

  <section class="end inked lines" aria-labelledby="end-h">
    <div class="w end-in" data-reveal>
      <h2 id="end-h" style="--i: 0">Try it on your own projects.</h2>
      <div class="cta" style="--i: 1">
        <a class="btn paper" href={release.href} data-download>Download for Mac</a>
        <a class="btn ghost-light" href={REPO}><Fragment set:html={starIcon.replace('<svg', '<svg class="star"')} />Star on GitHub<span class="count" data-stars></span></a>
      </div>
      <p class="fine" style="--i: 2">Free. macOS 13+, Apple silicon. <a href="/docs/getting-started/">Getting started</a></p>
    </div>
  </section>
</Site>

<style>
  .head {
    padding: 0 10px;
  }
  .head .k {
    display: block;
    margin-bottom: 14px;
  }
  .page-head .word {
    margin-top: 40px;
    margin-bottom: -3%;
  }
  .page-head .word text {
    font-size: 160px;
  }
  .sheet {
    padding: 28px 0 32px;
  }
  .end-in {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    padding: 64px 10px 72px;
  }
  .end h2 {
    font: 900 clamp(26px, 3vw, 44px)/1.05 var(--display);
    font-stretch: 112%;
    text-transform: uppercase;
  }
  .end .fine {
    color: var(--on-ink-muted);
  }
  .end .fine a {
    color: var(--paper);
  }
  @media (max-width: 640px) {
    .page-head {
      padding-top: 36px;
    }
    .end .cta .btn {
      flex: 1 1 auto;
    }
  }
</style>
