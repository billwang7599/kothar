---
// The sticky top bar on Overview and Features. It is clear over the blue field at the top of the page and turns to
// paper with a hairline once the page scrolls under it. The Wiki's header (StarlightHeader.astro) matches it.
import { latestRelease, REPO } from '../lib/release'

interface Props {
  current: 'overview' | 'features'
}
const { current } = Astro.props
const release = latestRelease()
const tabs = [
  { id: 'overview', label: 'Overview', href: '/' },
  { id: 'features', label: 'Features', href: '/features/' },
  { id: 'wiki', label: 'Wiki', href: '/docs/' },
]
---

<header class="nav top" data-nav>
  <div class="w bar">
    <a class="mark" href="/" aria-label="Kothar overview">(K)</a>
    <nav class="links" aria-label="Site">
      {
        tabs.map((t) => (
          <a class:list={['ul', { home: t.id === 'overview' }]} href={t.href} aria-current={t.id === current ? 'page' : undefined}>
            {t.label}
          </a>
        ))
      }
    </nav>
    <span class="end">
      <a class="ul" href={REPO}>GitHub</a>
      <a class="dl" href={release.href} data-download>Download</a>
    </span>
  </div>
</header>

<script is:inline>
  {
    const bar = document.querySelector('[data-nav]')
    const set = () => bar.classList.toggle('top', scrollY < 8)
    set()
    addEventListener('scroll', set, { passive: true })
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 20;
    height: var(--nav-h);
    background: var(--paper);
    border-bottom: 1px solid var(--line);
    transition:
      background-color var(--base) var(--ease),
      border-color var(--base) var(--ease);
  }
  /* At the very top, the bar shows the band under it. */
  .nav.top {
    background: var(--field);
    border-bottom-color: transparent;
  }
  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 100%;
    font: 600 12px/1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .mark {
    justify-self: start;
    padding-left: 10px;
    font: 900 22px/1 var(--display);
    font-stretch: 125%;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity var(--base) var(--ease);
  }
  .mark:hover {
    opacity: 0.7;
  }
  .links {
    display: flex;
    gap: 28px;
  }
  .end {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 18px;
    padding-right: 10px;
  }
  .dl {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    transition:
      background-color var(--base) var(--ease),
      transform var(--base) var(--ease),
      box-shadow var(--base) var(--ease);
  }
  .dl:hover {
    background: var(--ink-2);
    transform: translateY(-1px);
    box-shadow: 0 2px 0 var(--field);
  }
  .dl:active {
    transform: scale(0.97);
    box-shadow: none;
    transition-duration: var(--fast);
  }
  @media (max-width: 640px) {
    .bar {
      grid-template-columns: auto 1fr;
      gap: 14px;
      font-size: 11px;
    }
    .mark {
      padding-left: 0;
    }
    .links {
      justify-self: end;
      gap: 14px;
    }
    .links .home {
      display: none;
    }
    .end {
      display: none;
    }
  }
</style>
