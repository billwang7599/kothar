---
// The Wiki's header: the same tabs, GitHub link and Download pill as the Overview and Features pages, plus
// Starlight's search and theme menu. The frosted look comes from theme.css.
import Search from 'virtual:starlight/components/Search'
import SiteTitle from 'virtual:starlight/components/SiteTitle'
import ThemeSelect from 'virtual:starlight/components/ThemeSelect'
import { githubMark } from '../lib/icons'
import { latestRelease, REPO } from '../lib/release'

const release = await latestRelease()
---

<div class="kh">
  <div class="title"><SiteTitle /></div>
  <nav class="tabs" aria-label="Site">
    <a href="/">Overview</a>
    <a href="/features/">Features</a>
    <a href="/docs/" aria-current="page">Wiki</a>
  </nav>
  <div class="search print:hidden"><Search /></div>
  <div class="end print:hidden">
    <span class="theme"><ThemeSelect /></span>
    <a class="icon" href={REPO} aria-label="Kothar on GitHub" set:html={githubMark} />
    <a class="pill" href={release.href} data-download>Download</a>
  </div>
</div>

<style>
  .kh {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 100%;
  }
  .title {
    min-width: 0;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }
  .tabs {
    display: none;
    gap: 24px;
    font-size: 14px;
  }
  .tabs a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .tabs a:hover,
  .tabs a[aria-current='page'] {
    color: var(--sl-color-white);
  }
  .search {
    display: flex;
    margin-left: auto;
  }
  .end {
    display: none;
    align-items: center;
    gap: 14px;
  }
  .icon {
    display: inline-flex;
    padding: 4px;
    color: var(--sl-color-gray-3);
    transition: color 0.2s ease;
  }
  .icon:hover {
    color: var(--sl-color-white);
  }
  .icon :global(svg) {
    width: 18px;
    height: 18px;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    height: 28px;
    padding: 0 14px;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: #fff;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }
  .pill:hover {
    filter: brightness(1.08);
  }
  @media (min-width: 50rem) {
    .tabs,
    .end {
      display: flex;
    }
  }
  @media (min-width: 72rem) {
    .search {
      margin-left: 0;
      flex: 1;
      justify-content: center;
    }
  }
</style>
