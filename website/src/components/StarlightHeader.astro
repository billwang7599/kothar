---
// The Wiki's header, matched to the Overview and Features nav (Nav.astro): the (K) mark, mono capital tabs, GitHub
// and an ink Download button, plus Starlight's search and theme menu. Colours come from theme.css.
import Search from 'virtual:starlight/components/Search'
import ThemeSelect from 'virtual:starlight/components/ThemeSelect'
import { latestRelease, REPO } from '../lib/release'

const release = latestRelease()
---

<div class="kh">
  <a class="mark" href="/" aria-label="Kothar overview">(K)</a>
  <nav class="tabs" aria-label="Site">
    <a href="/">Overview</a>
    <a href="/features/">Features</a>
    <a href="/docs/" aria-current="page">Wiki</a>
  </nav>
  <div class="search print:hidden"><Search /></div>
  <div class="end print:hidden">
    <span class="theme"><ThemeSelect /></span>
    <a class="tab" href={REPO}>GitHub</a>
    <a class="dl" href={release.href} data-download>Download</a>
  </div>
</div>

<style>
  .kh {
    display: flex;
    align-items: center;
    gap: 28px;
    height: 100%;
  }
  .mark {
    flex: none;
    color: var(--sl-color-white);
    font: 900 22px/1 var(--sl-font);
    font-stretch: 125%;
    letter-spacing: -0.02em;
    text-decoration: none;
    transition: opacity 200ms var(--kothar-ease);
  }
  .mark:hover {
    opacity: 0.7;
  }
  .tabs {
    display: none;
    gap: 24px;
  }
  .tabs a,
  .tab {
    color: var(--sl-color-gray-3);
    font: 600 12px/1 var(--sl-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 1px no-repeat;
    padding-bottom: 2px;
    transition:
      color 200ms var(--kothar-ease),
      background-size 200ms var(--kothar-ease);
  }
  .tabs a:hover,
  .tabs a[aria-current='page'],
  .tab:hover {
    color: var(--sl-color-white);
    background-size: 100% 1px;
  }
  .search {
    display: flex;
    margin-left: auto;
  }
  .end {
    display: none;
    align-items: center;
    gap: 16px;
  }
  .dl {
    display: inline-flex;
    align-items: center;
    height: 30px;
    padding: 0 12px;
    background: var(--sl-color-white);
    color: var(--sl-color-black);
    font: 600 12px/1 var(--sl-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    white-space: nowrap;
    transition:
      transform 200ms var(--kothar-ease),
      box-shadow 200ms var(--kothar-ease);
  }
  .dl:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 0 #8a9dc4;
  }
  .dl:active {
    transform: scale(0.97);
    box-shadow: none;
    transition-duration: 150ms;
  }
  @media (min-width: 50rem) {
    .tabs,
    .end {
      display: flex;
    }
  }
  @media (min-width: 72rem) {
    .search {
      margin-left: 0;
      flex: 1;
      justify-content: center;
    }
  }
</style>
