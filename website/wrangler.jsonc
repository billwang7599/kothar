// Cloudflare Workers Builds deploys the site with this file (root directory: website).
// The site is static: Astro builds it into dist/, and the Worker serves those files.
{
  "name": "kothar",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Branches other than main run `npx wrangler preview`, which needs this block (it can be empty).
  "previews": {}
}
