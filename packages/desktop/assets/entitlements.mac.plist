<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Entitlements for the hardened runtime, used only when Kothar is signed with a Developer ID (see
     scripts/signing.ts), for the app and every Electron helper.

     allow-jit: V8, in the main process and the renderer and GPU helpers, compiles JavaScript into MAP_JIT memory.
     That's the only one Electron needs (it's all of @electron/osx-sign's default for apps and helpers).

     Left out on purpose:
     - allow-unsigned-executable-memory: Electron hasn't needed it since 12; MAP_JIT covers V8.
     - disable-library-validation: every native file in the bundle is signed with Kothar's own identity, and nothing
       loads plugins or dylibs from outside it.
     - automation.apple-events: Kothar sends no Apple events; it opens files, folders and terminals with `open`.
     - camera, microphone, location: unused.
     Engines (claude, pi, codex, opencode), sandbox-exec and git are separate programs from outside the bundle with their
     own signatures. Kothar's entitlements don't pass to them and don't limit them. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
  </dict>
</plist>
